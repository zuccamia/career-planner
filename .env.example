GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret
# Optional — space-separated Google Drive scopes. Defaults to appdata + file.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.appdata https://www.googleapis.com/auth/drive.file

# LLM_* are OPTIONAL. Set them to keep your provider key on the server so it
# survives across browsers, private windows, and IndexedDB wipes. Leave them
# unset to use the browser-only path: configure the key once in Settings →
# AI provider and it lives in this browser's IndexedDB (fastest to set up,
# but you'll re-enter it if you switch browsers or wipe local data).
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your_key_here

# SCRAPER_* are OPTIONAL. Enable to have the dossier builder pull live company
# website content and auto-discover ATS URLs. Backends: "firecrawl" (hosted;
# needs SCRAPER_API_KEY) or "crawl4ai" (self-hosted; run
# `docker run -p 11235:11235 unclecode/crawl4ai:latest` and point
# SCRAPER_BASE_URL at http://localhost:11235). Leave unset to skip scraping
# server-side; users can still configure BYOK scraping per-browser in
# Settings → Web scraper. See deploy/scraper/README.md for full details.
SCRAPER_BACKEND=crawl4ai
SCRAPER_BASE_URL=http://localhost:11235
SCRAPER_API_KEY=fc-your-firecrawl-key
