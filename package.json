{
  "name": "career-planner",
  "version": "1.0.0",
  "description": "Blank-canvas Go webapp scaffold for a company dossier and job tracking MVP.",
  "main": "index.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./web/static/tailwind.css -o ./web/static/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./web/static/tailwind.css -o ./web/static/app.css --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:web-test": "go build -o bin/web-test ./cmd/web",
    "test:e2e": "npm run build:web-test && playwright test",
    "test:e2e:headed": "npm run build:web-test && playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuccamia/career-planner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zuccamia/career-planner/issues"
  },
  "homepage": "https://github.com/zuccamia/career-planner#readme",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/cli": "^4.3.3",
    "happy-dom": "^20.14.3",
    "tailwindcss": "^4.3.3",
    "vitest": "^2.1.0"
  }
}
